# Vila 27 – premenné prostredia. Tento súbor je IBA vzor a je v gite.
# NIKDY sem nepíš skutočné heslá ani tokeny – kontrola A1 to zachytí a repozitár je verejný.
#
# Lokálne:   skopíruj ho na .env (ten je v .gitignore) a tam doplň svoje hodnoty:
#              cp .env.example .env
#            `npm run dev` .env načíta sám, netreba nič inštalovať.
# Na hostingu: rovnaké názvy nastav v premenných prostredia u poskytovateľa.

# Token pre /api/queue a nástenku objednávok. Minimálne 32 znakov.
# Vygeneruj napr.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINT_TOKEN=__VYGENERUJ_ASPON_32_ZNAKOV__

# Prihlásenie do správy ponuky (/admin-produkty). Heslo aspoň 12 znakov.
ADMIN_USER=__DOPLNIT__
ADMIN_PASS=__DOPLNIT__

# Upstash Redis (REST). Bez nich beží iba lokálny pamäťový režim.
KV_REST_API_URL=https://__DOPLNIT__.upstash.io
KV_REST_API_TOKEN=__DOPLNIT__

# Koľko dní sa držia objednávky a osobné údaje v Redise (GDPR – E1).
ORDER_TTL_DAYS=3

# Voliteľné: Cloudflare Turnstile. Kým nie sú vyplnené, overenie je vypnuté.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
